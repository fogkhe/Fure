DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/fure
DATABASE_AUTO_MIGRATE=true
EXECUTION_HEARTBEAT_INTERVAL=1
EXECUTION_LEASE_SECONDS=30
SESSION_LIFETIME_SECONDS=604800
# Enable when the browser connects over HTTPS (including through a reverse proxy).
SESSION_COOKIE_SECURE=false

# Published ports when starting with Docker Compose.
FRONTEND_PORT=3000
API_PORT=8000
